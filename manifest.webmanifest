{
  "id": "./",
  "name": "Setline 7.1.1 Fitness Tracker",
  "short_name": "Setline",
  "description": "Editorial workout and nutrition tracker with low-memory live barcode scanning, serving-aware portions including slices, expanded offline exercises, explainable XP, mixed kg/lb support and local-first data.",
