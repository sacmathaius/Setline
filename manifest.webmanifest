  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "portrait-primary",
  "background_color": "#F1EEE9",
  "theme_color": "#F1EEE9",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "fitness",
    "health",
    "lifestyle"
  ],
  "prefer_related_applications": false,
